PORT=3000
NODE_ENV=development

# Use Neon connection strings. DATABASE_URL should use the pooled endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_POOLER_HOST/DBNAME?sslmode=require"
# Use Neon’s direct (non-pooler) endpoint for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/DBNAME?sslmode=require"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Used only by npm run seed:admin; choose your own credentials and keep this file private.
ADMIN_USERNAME="replace-with-your-admin-username"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"



JWT_SECRET=
ADMIN_USERNAME= 
ADMIN_PASSWORD =